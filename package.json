{
  "name": "repo-scout-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "GitHub Repo Scout - local-first repository discovery & implementation intelligence engine",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "REPO_SCOUT_LIVE=1 vitest run tests/integration/live",
    "bench": "node --import tsx tests/benchmarks/run.ts",
    "eval": "node --import tsx tests/benchmarks/relevance.ts",
    "audit": "pnpm audit --prod",
    "verify:install": "node scripts/verify-install.mjs",
    "docs:gen": "tsx scripts/gen-docs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  }
}
