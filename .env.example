# Copy to .env or export in your shell. Never commit real values.
GITHUB_TOKEN=            # optional; public read access is enough
# GITLAB_TOKEN=
# CODEBERG_TOKEN=
# BRAVE_API_KEY=         # enables the `web` provider
# SEARXNG_URL=           # or a SearXNG instance with JSON output enabled
# REPO_SCOUT_HOME=       # data directory
# REPO_SCOUT_OFFLINE=1
# NODE_USE_ENV_PROXY=1   # honour HTTP(S)_PROXY (Node >= 22.21)
